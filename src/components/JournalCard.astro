---
export interface Props { title: string; date: string; excerpt: string; slug: string; draft?: boolean; }
const { title, date, excerpt, slug, draft = false } = Astro.props;
---
<article class="journal-card">
  <a class="journal-card__link" href={`/teaching/journal/${slug}`}>
    <time class="journal-card__date">{date}</time>
    <h3 class="journal-card__title">{title}</h3>
    <p class="journal-card__excerpt">{excerpt}</p>
  </a>
  {draft && <p class="journal-card__draft"><span aria-hidden="true"></span>Sample entry · replace with your journal</p>}
</article>

<style>
  .journal-card { display: flex; min-width: 0; min-height: 178px; flex-direction: column; padding: 18px 20px; border: 1px solid var(--border); border-radius: var(--radius-card); background: var(--surface); }
  .journal-card__link { display: flex; flex: 1; flex-direction: column; color: inherit; }
  .journal-card__link:focus-visible { outline-offset: 3px; border-radius: 4px; }
  .journal-card__date { margin-bottom: 10px; color: var(--accent-text); font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .journal-card__title { margin-bottom: 8px; color: var(--ink); font-size: 16px; line-height: 1.3; }
  .journal-card__excerpt { flex: 1; color: var(--text); font-size: 13px; line-height: 1.5; }
  .journal-card__draft { display: flex; align-items: center; gap: 6px; margin-top: 12px; color: var(--muted); font-size: 10px; }
  .journal-card__draft span { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
  .journal-card:hover { border-color: var(--primary); box-shadow: var(--shadow-card); }
</style>
