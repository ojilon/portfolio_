---
export interface Props {
  title: string;
  date: string;
  excerpt: string;
  slug: string;
  draft?: boolean;
}
const { title, date, excerpt, slug, draft } = Astro.props;
---
<article class="card">
  <a class="card__link" href={`/teaching/journal/${slug}`}>
    <div class="card__top">
      <span class="card__date">{date}</span>
    </div>
    <h3 class="card__title">{title}</h3>
    <p class="card__excerpt">{excerpt}</p>
  </a>
  {draft && (
    <p class="card__draft">Sample entry · replace with your journal</p>
  )}
</article>

<style>
  .card {
    border-radius: var(--radius-card);
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .card__link {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }
  .card__top {
    margin-bottom: 10px;
  }
  .card__date {
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .card__title {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 8px 0;
    color: var(--ink);
  }
  .card__excerpt {
    font-size: 14px;
    line-height: 1.5;
    color: var(--text);
    margin: 0;
    flex: 1;
  }
  .card__draft {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
