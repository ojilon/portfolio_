---
import LinkList from "@/components/LinkList.astro";
import { site, siteLinks, footerYear } from "@/data/site";
---
<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__left">
      <p class="footer__identity"><strong>{site.name}</strong> · Biology &amp; Chemistry teacher trainee</p>
      <p class="footer__note">Made with care in Uganda · © {footerYear}</p>
    </div>
    <LinkList items={siteLinks} />
  </div>
</footer>

<style>
  .footer { margin-top: auto; border-top: 1px solid var(--border); }
  .footer__inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 26px; }
  .footer__identity { margin-bottom: 3px; color: var(--text); font-size: 12px; }
  .footer__identity strong { color: var(--ink); }
  .footer__note { color: var(--muted); font-size: 11px; }
  @media (max-width: 640px) { .footer__inner { flex-direction: column; align-items: center; gap: 16px; padding-block: 22px; text-align: center; } }
</style>
