---
import LinkList from "@/components/LinkList.astro";
import { site, footerYear } from "@/data/site";
---
<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__left">
      <p class="footer__identity">
        <strong>{site.name}</strong> · Biology &amp; Chemistry teacher trainee
      </p>
      <p class="footer__note">
        Made with care in Uganda · © {footerYear}
      </p>
    </div>
    <div class="footer__right">
      <LinkList items={site.links} vertical={false} />
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--surface);
    margin-top: auto;
  }
  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 32px 0;
    gap: 30px;
    flex-wrap: wrap;
  }
  .footer__identity {
    font-weight: 700;
    color: var(--ink);
    font-size: 15px;
    margin: 0 0 4px 0;
  }
  .footer__note {
    font-size: 12px;
    color: var(--muted);
    margin: 0;
    font-family: var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .footer__right {
    display: flex;
    gap: 26px;
    align-items: center;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .footer__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 20px;
      text-align: center;
    }
    .footer__right {
      justify-content: center;
    }
  }
</style>
