---
export interface Props {
  items: { label: string; url: string }[];
  vertical?: boolean;
}
const { items, vertical = false } = Astro.props;
---
<nav class:list={["linklist", { "linklist--vertical": vertical }]} aria-label="Social links">
  {items.map((item, index) => (
    <>
      {item.url.includes("TODO:") ? (
        <span class="linklist__item linklist__placeholder" aria-label={`${item.label} address needs to be added`}>{item.label}</span>
      ) : (
        <a class="linklist__item" href={item.url}>{item.label}</a>
      )}
      {index < items.length - 1 && <span class="linklist__divider" aria-hidden="true"></span>}
    </>
  ))}
</nav>

<style>
  .linklist { display: flex; align-items: center; gap: 14px; }
  .linklist--vertical { align-items: flex-start; flex-direction: column; gap: 12px; }
  .linklist__item { color: var(--primary); font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.08em; white-space: nowrap; }
  .linklist__item:hover { text-decoration: underline; }
  .linklist__placeholder { color: var(--muted); cursor: default; }
  .linklist__divider { width: 1px; height: 14px; background: var(--border); }
  .linklist--vertical .linklist__divider { display: none; }
  @media (max-width: 640px) { .linklist { justify-content: center; gap: 12px; } .linklist__item { font-size: 10px; } }
</style>
