---
export interface Props {
  title: string;
  subject: "Biology" | "Chemistry";
  topic: string;
  summary: string;
  slug: string;
}
const { title, subject, topic, summary, slug } = Astro.props;
---
<article class="note-card" data-note-card data-subject={subject} data-topic={topic}>
  <a class="note-card__link" href={`/teaching/notes/${slug}`}>
    <div class="note-card__top">
      <span class:list={["note-card__subject", subject === "Biology" ? "is-biology" : "is-chemistry"]}>{subject}</span>
      <span class="note-card__topic">{topic}</span>
    </div>
    <h3 class="note-card__title">{title}</h3>
    <p class="note-card__summary">{summary}</p>
  </a>
</article>

<style>
  .note-card { min-width: 0; min-height: 150px; border: 1px solid var(--border); border-radius: var(--radius-card); background: var(--surface); transition: var(--motion); }
  .note-card:hover { border-color: var(--primary); box-shadow: var(--shadow-card); }
  .note-card[hidden] { display: none; }
  .note-card__link { display: block; height: 100%; padding: 18px 20px; color: inherit; }
  .note-card__link:focus-visible { outline-offset: -4px; border-radius: var(--radius-card); }
  .note-card__top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 12px; }
  .note-card__subject { font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .note-card__subject.is-biology { color: var(--subject-biology-text); }
  .note-card__subject.is-chemistry { color: var(--subject-chemistry-text); }
  .note-card__topic { max-width: 55%; overflow: hidden; padding: 4px 9px; border: 1px solid var(--border); border-radius: var(--radius-pill); color: var(--muted); font-family: var(--font-mono); font-size: 9px; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
  .note-card__title { margin-bottom: 7px; color: var(--ink); font-size: 16px; line-height: 1.3; }
  .note-card__summary { overflow: hidden; color: var(--text); font-size: 13px; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
</style>
