---
export interface Props {
  label: string;
  level?: 2 | 3 | 4;
  dot?: boolean;
}
const { label, level = 2, dot = true } = Astro.props;
const Tag = level === 3 ? "h3" : level === 4 ? "h4" : "h2";
---
<Tag class:list={["section-heading", `section-heading--${level}`]}>
  {dot && <span class="section-heading__dot" aria-hidden="true"></span>}
  {label}
</Tag>

<style>
  .section-heading { display: flex; align-items: center; gap: 10px; margin: 0 0 16px; color: var(--ink); font-weight: 700; letter-spacing: -0.01em; }
  .section-heading__dot { width: 8px; height: 8px; flex: 0 0 auto; border-radius: 50%; background: var(--accent); }
  .section-heading--2 { font-size: var(--h2-desktop); line-height: 1.05; }
  .section-heading--3 { font-size: 24px; }
  .section-heading--4 { font-size: 18px; }
  @media (max-width: 640px) { .section-heading--2 { font-size: var(--h2-mobile); } }
</style>
