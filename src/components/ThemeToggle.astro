---
export interface Props {}
---
<button class="theme-toggle" id="theme-toggle" aria-checked="false">
  <span class="theme-toggle__label" id="theme-toggle-label">Dark mode</span>
  <span class="theme-toggle__icon" aria-hidden="true">
    <svg class="theme-toggle__sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="5" />
      <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
    </svg>
    <svg class="theme-toggle__moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79" />
    </svg>
  </span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: var(--sage);
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 6px 12px;
    cursor: pointer;
    transition: var(--motion);
  }
  .theme-toggle:hover {
    border-color: var(--primary);
    background: var(--sage-strong);
  }
  .theme-toggle:focus-visible {
    outline: 3px solid var(--primary);
    outline-offset: 2px;
  }
  .theme-toggle__icon {
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .theme-toggle__sun,
  .theme-toggle__moon {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  .theme-toggle__moon {
    opacity: 0;
    pointer-events: none;
  }
  .dark .theme-toggle__sun { opacity: 0; pointer-events: none; }
  .dark .theme-toggle__moon { opacity: 1; pointer-events: auto; }
</style>

<script>
  import "../scripts/theme-toggle.js";
</script>
