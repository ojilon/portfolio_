---
export interface Props {
  status: "released" | "in-progress" | "idea";
  label?: string;
}
const { status, label } = Astro.props;

const statusConfig: Record<string, { bg: string; text: string; dot: string }> = {
  released: { bg: "#E0EFE7", text: "#1F6B4F", dot: "#1F6B4F" },
  "in-progress": { bg: "#F8E6D9", text: "#A5501F", dot: "#A5501F" },
  idea: { bg: "#E8E9F5", text: "#5A5FA8", dot: "#5A5FA8" },
};
const cfg = statusConfig[status] ?? statusConfig.released;
const text = label ?? status.replace("-", " ");
---
<span class="badge" style={`--badge-bg: ${cfg.bg}; --badge-text: ${cfg.text}; --badge-dot: ${cfg.dot};`}>
  <span class="badge__dot" aria-hidden="true"></span>
  {text}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: 9999px;
    background: var(--badge-bg);
    color: var(--badge-text);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 4px 10px;
  }
  .badge__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--badge-dot);
    display: block;
  }
</style>
