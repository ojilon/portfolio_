---
export interface Props {
  status: "released" | "in-progress" | "idea";
  label?: string;
}
const { status, label } = Astro.props;
const statusLabel = label ?? (status === "in-progress" ? "In progress" : status === "released" ? "Released" : "Idea");
---
<span class:list={["badge", `badge--${status}`]}>
  <span class="badge__dot" aria-hidden="true"></span>{statusLabel}
</span>

<style>
  .badge { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 6px; padding: 4px 9px; border-radius: var(--radius-pill); font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: 0.06em; white-space: nowrap; }
  .badge--released { color: var(--status-released-text); background: var(--status-released-bg); }
  .badge--in-progress { color: var(--status-progress-text); background: var(--status-progress-bg); }
  .badge--idea { color: var(--status-idea-text); background: var(--status-idea-bg); }
  .badge__dot { width: 6px; height: 6px; flex: 0 0 auto; border-radius: 50%; background: currentColor; }
</style>
