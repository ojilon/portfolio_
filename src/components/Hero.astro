---
import Avatar from "@/components/Avatar.astro";
import { site } from "@/data/site";
---
<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="hero__eyebrow eyebrow"><span class="accent-dot" aria-hidden="true"></span>LEARNING SCIENCE · BUILDING USEFUL THINGS</p>
      <h1 id="hero-heading" class="hero__title">
        <span>Ojilong</span>
        <span>Yusuf<span class="dot" aria-hidden="true">.</span></span>
      </h1>
      <p class="hero__line">Biology &amp; Chemistry teacher trainee · Builder of practical tools</p>
      <p class="hero__desc">I’m working toward a classroom where curiosity has room to grow—and building small, thoughtful tools that make learning a little easier.</p>
      <div class="hero__cta">
        <a href="/teaching" class="btn btn--fill">Explore teaching <span aria-hidden="true">↗</span></a>
        <a href="/projects" class="btn btn--outline">See my projects <span aria-hidden="true">↗</span></a>
      </div>
      <p class="hero__uni">
        <span class="hero__uni-icon" aria-hidden="true">✳</span>
        <span><strong>Kyambogo University</strong> · Soroti Learning Centre · Year 2</span>
      </p>
    </div>
    <div class="hero__visual">
      <div class="hero-panel">
        <span class="hero-panel__badge" aria-hidden="true">✳</span>
        <div class="hero-panel__photo"><Avatar size={220} label={site.name} alt={`Portrait of ${site.name}`} /></div>
        <div class="hero-panel__floating">
          <p class="hero-panel__floating-title">Learning science, building tools</p>
          <p class="hero-panel__floating-sub">Kyambogo University · Soroti</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding: 64px 0 24px; }
  .hero__inner { display: grid; grid-template-columns: 1.4fr 1fr; gap: 64px; align-items: center; }
  .hero__eyebrow { margin-bottom: 14px; }
  .hero__title { margin-bottom: 14px; font-size: var(--h1-desktop); line-height: 1; letter-spacing: -0.04em; }
  .hero__title > span { display: block; }
  .hero__line { margin-bottom: 16px; color: var(--primary); font-size: 17px; font-weight: 700; }
  .hero__desc { max-width: 500px; margin-bottom: 22px; font-size: var(--text-lg); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 22px; }
  .hero__uni { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 13px; }
  .hero__uni strong { color: var(--text); }
  .hero__uni-icon { display: grid; width: 28px; height: 28px; flex: 0 0 auto; place-items: center; border-radius: 50%; color: var(--primary); background: var(--sage-strong); }
  .hero-panel { position: relative; display: grid; min-height: 420px; place-items: center; overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius-panel); background: var(--sage); }
  .hero-panel::before, .hero-panel::after { position: absolute; content: ""; border: 1px solid color-mix(in srgb, var(--primary) 16%, transparent); border-radius: 50%; pointer-events: none; }
  .hero-panel::before { top: -160px; left: -130px; width: 390px; height: 390px; box-shadow: 0 0 0 22px color-mix(in srgb, var(--primary) 4%, transparent); }
  .hero-panel::after { right: -170px; bottom: -210px; width: 420px; height: 420px; box-shadow: 0 0 0 24px color-mix(in srgb, var(--accent) 5%, transparent); }
  .hero-panel__badge { position: absolute; z-index: 1; top: 24px; right: 24px; display: grid; width: 40px; height: 40px; place-items: center; border-radius: 12px; color: var(--accent); background: var(--peach); }
  .hero-panel__photo { position: relative; z-index: 1; width: 220px; height: 220px; overflow: hidden; border: 8px solid var(--surface); border-radius: 50%; background: var(--sage-strong); box-shadow: 0 8px 22px rgb(27 52 44 / 12%); }
  .hero-panel__photo img { width: 100%; height: 100%; object-fit: cover; }
  .hero-panel__floating { position: absolute; z-index: 2; right: 18px; bottom: 18px; width: min(190px, calc(100% - 36px)); padding: 14px 16px; border: 1px solid var(--border); border-radius: 16px; background: var(--surface); box-shadow: var(--shadow-card); }
  .hero-panel__floating-title { margin-bottom: 5px; color: var(--ink); font-size: 13px; font-weight: 700; line-height: 1.35; }
  .hero-panel__floating-sub { color: var(--muted); font-size: 11px; line-height: 1.4; }

  @media (max-width: 800px) {
    .hero { padding-top: 42px; }
    .hero__inner { grid-template-columns: 1fr; gap: 28px; }
    .hero__title { font-size: var(--h1-mobile); }
    .hero-panel { min-height: 300px; }
    .hero-panel__photo { width: 170px; height: 170px; }
  }
  @media (max-width: 380px) {
    .hero { padding-top: 32px; }
    .hero__title { font-size: 42px; }
    .hero__cta { gap: 8px; }
    .hero__cta .btn { padding-inline: 14px; font-size: 14px; }
    .hero-panel { min-height: 270px; }
    .hero-panel__photo { width: 145px; height: 145px; }
    .hero-panel__floating { right: 10px; bottom: 10px; width: 164px; padding: 10px 12px; }
  }
</style>
