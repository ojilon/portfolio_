---
export interface Props {
  src?: string;
  alt?: string;
  size?: number;
  label?: string;
}
const { src, alt = "Ojilong Yusuf", size = 40, label } = Astro.props;
const initials = (label ?? "OY").split(" ").map((w) => w[0]).join("").toUpperCase().slice(0, 2);
const hasImage = Boolean(src);
---
<span
  class="avatar"
  style={`--size: ${size}px;`}
  aria-label={label ?? alt}
>
  {hasImage && (
    <img src={src} alt={alt} width={size} height={size} loading="lazy" />
  )}
  {!hasImage && <span class="avatar__initials" aria-hidden="true">{initials}</span>}
</span>

<style>
  .avatar {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    overflow: hidden;
    background: var(--sage);
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: calc(var(--size) * 0.35);
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .avatar__initials {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
  }
  .dark .avatar {
    background: var(--sage);
    color: var(--primary);
  }
</style>
