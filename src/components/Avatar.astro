---
import { existsSync } from "node:fs";
import { resolve } from "node:path";

export interface Props {
  src?: string;
  alt?: string;
  size?: number;
  label?: string;
  loading?: "eager" | "lazy";
}
const { src = "/assets/profile.jpg", alt = "Portrait of Ojilong Yusuf", size = 220, label = "Ojilong Yusuf", loading = "eager" } = Astro.props;
const imagePath = src.startsWith("/") ? resolve(process.cwd(), "public", src.slice(1)) : "";
const hasImage = Boolean(imagePath && existsSync(imagePath));
---
<span class="avatar" style={`--avatar-size: ${size}px;`} role="img" aria-label={hasImage ? alt : `Portrait placeholder for ${label}`}>
  {hasImage ? (
    <img src={src} alt={alt} width={size} height={size} loading={loading} fetchpriority={loading === "eager" ? "high" : "auto"} />
  ) : (
    <span class="avatar__silhouette" aria-hidden="true">
      <span class="avatar__head"></span>
      <span class="avatar__body"><span>OY</span></span>
    </span>
  )}
</span>

<style>
  .avatar { position: relative; display: block; width: 100%; height: 100%; overflow: hidden; border-radius: 50%; background: var(--sage-strong); }
  .avatar img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .avatar__silhouette { position: relative; display: grid; width: 100%; height: 100%; place-items: center; background: var(--sage-strong); }
  .avatar__head { position: absolute; top: 22%; width: 28%; aspect-ratio: 1; border-radius: 50%; background: #7C9E91; }
  .avatar__body { position: absolute; bottom: -10%; display: grid; width: 72%; height: 52%; place-items: center; border-radius: 48% 48% 0 0; color: #fff; background: #6F9485; font-size: calc(var(--avatar-size) * 0.09); font-weight: 700; }
</style>
