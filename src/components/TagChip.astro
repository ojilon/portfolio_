---
export interface Props { label: string; }
const { label } = Astro.props;
---
<span class="tag">{label}</span>

<style>
  .tag { display: inline-flex; align-items: center; padding: 4px 9px; border: 1px solid var(--border); border-radius: var(--radius-pill); color: var(--text); background: var(--surface); font-family: var(--font-mono); font-size: 10px; font-weight: 500; line-height: 1.2; letter-spacing: 0.035em; }
</style>
