---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { site } from "@/data/site";

const nav = [
  { href: "/about", label: "About" },
  { href: "/teaching", label: "Teaching" },
  { href: "/projects", label: "Projects" },
  { href: "/contact", label: "Contact" },
];
const current = Astro.url.pathname;
---
<header class="header">
  <div class="header__inner container">
    <a href="/" class="header__brand" aria-label={`${site.name}, home`}>
      <span class="header__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20V10m0 5c-4.4 0-7-2.4-7-6.5 4.1 0 7 2.2 7 6.5Zm0-3c0-4.1 2.9-6.5 7-6.5 0 4.1-2.6 6.5-7 6.5Z" />
        </svg>
      </span>
      <span class="header__brand-text">
        <span class="header__name">{site.name}</span>
        <span class="header__role">TEACHER IN THE MAKING</span>
      </span>
    </a>

    <nav class="header__nav" aria-label="Main navigation">
      {nav.map((item) => {
        const active = current === item.href || current.startsWith(`${item.href}/`);
        return (
          <a href={item.href} class:list={["header__nav-link", { "is-active": active }]} aria-current={active ? "page" : undefined}>
            {item.label}
          </a>
        );
      })}
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .header { border-bottom: 1px solid var(--border); background: var(--bg); }
  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 82px;
    gap: 24px;
  }
  .header__brand { display: inline-flex; align-items: center; justify-self: start; gap: 10px; color: inherit; }
  .header__mark { display: grid; width: 40px; height: 40px; place-items: center; border-radius: 12px; color: var(--button-primary-text); background: var(--primary); }
  .header__brand-text { display: block; }
  .header__name { display: block; color: var(--ink); font-size: 15px; font-weight: 700; line-height: 1.25; }
  .header__role { display: block; margin-top: 2px; color: var(--muted); font-family: var(--font-mono); font-size: 9px; font-weight: 700; letter-spacing: 0.12em; }
  .header__nav { display: flex; align-items: center; justify-content: center; gap: 8px; }
  .header__nav-link { padding: 8px 14px; border-radius: var(--radius-pill); color: var(--text); font-size: 14px; font-weight: 700; white-space: nowrap; }
  .header__nav-link:hover, .header__nav-link.is-active { color: var(--primary); background: var(--sage-strong); }
  .header__inner > :global(.theme-toggle) { justify-self: end; }

  @media (max-width: 760px) {
    .header__inner { grid-template-columns: 1fr auto; min-height: 0; gap: 12px 16px; padding-block: 12px; }
    .header__brand { grid-column: 1; }
    .header__nav { grid-column: 1 / -1; grid-row: 2; justify-content: space-between; gap: 2px; }
    .header__nav-link { padding: 7px 10px; font-size: 13px; }
    .header__inner > :global(.theme-toggle) { grid-column: 2; grid-row: 1; }
  }
  @media (max-width: 360px) {
    .header__nav-link { padding-inline: 7px; font-size: 12px; }
    .header__role { font-size: 8px; }
  }
</style>
