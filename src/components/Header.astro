---
import Avatar from "@/components/Avatar.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { site } from "@/data/site";

const nav = [
  { href: "/", label: "About" },
  { href: "/teaching", label: "Teaching" },
  { href: "/projects", label: "Projects" },
  { href: "/contact", label: "Contact" },
];

const current = Astro.url.pathname;
---
<header class="header">
  <div class="header__inner container">
    <div class="header__brand">
      <a href="/" class="header__logo">
        <Avatar size={40} label={site.name} />
        <div class="header__brand-text">
          <span class="header__name">{site.name}</span>
          <span class="header__role">TEACHER IN THE MAKING</span>
        </div>
      </a>
      <ThemeToggle />
    </div>

    <nav class="header__nav" aria-label="Main navigation">
      {nav.map((item) => {
        const active = current === item.href;
        return (
          <a
            href={item.href}
            class={`header__nav-link ${active ? "header__nav-link--active" : ""}`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    border-bottom: 1px solid var(--border);
    z-index: 50;
    backdrop-filter: blur(6px);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
    gap: 20px;
  }
  .header__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }
  .header__logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .header__name {
    font-weight: 700;
    color: var(--ink);
    font-size: 17px;
    letter-spacing: -0.01em;
    display: block;
  }
  .header__role {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--primary);
    display: block;
  }
  .header__nav {
    display: flex;
    gap: 30px;
    align-items: center;
  }
  .header__nav-link {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
    padding: 8px 0;
    position: relative;
  }
  .header__nav-link:hover {
    color: var(--primary);
  }
  .header__nav-link--active {
    color: var(--primary);
    background: var(--sage-strong);
    padding: 6px 14px;
    border-radius: 9999px;
  }

  @media (max-width: 640px) {
    .header__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      padding: 16px 0;
    }
    .header__brand {
      width: 100%;
      justify-content: space-between;
    }
    .header__nav {
      width: 100%;
      justify-content: space-between;
      gap: 0;
    }
    .header__nav-link {
      font-size: 14px;
    }
  }
</style>
