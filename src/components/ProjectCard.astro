---
import ProjectPreview from "@/components/ProjectPreview.astro";
import StatusBadge from "@/components/StatusBadge.astro";
import TagChip from "@/components/TagChip.astro";

export interface Props {
  name: string;
  status: "released" | "in-progress" | "idea";
  summary: string;
  tags: string[];
  previewKind: "phone-pc" | "browser" | "terminal" | "code" | "shortcut";
  screenshot?: string;
  slug: string;
  featured?: boolean;
}
const { name, status, summary, tags, previewKind, screenshot, slug } = Astro.props;
---
<a class="card" href={`/projects/${slug}`}>
  <div class="card__preview">
    <ProjectPreview previewKind={previewKind} screenshot={screenshot} />
  </div>
  <div class="card__body">
    <div class="card__header">
      <h3 class="card__name">{name}</h3>
      <StatusBadge status={status} />
    </div>
    <p class="card__summary">{summary}</p>
    <div class="card__tags">
      {tags.map((t) => <TagChip label={t} />)}
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-card);
    border: 1px solid var(--border);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: var(--motion);
  }
  .card:focus-visible {
    outline: 3px solid var(--primary);
    outline-offset: 2px;
  }
  .card:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-card);
  }
  .card__preview {
    width: 100%;
    height: 200px;
    flex-shrink: 0;
  }
  .card__body {
    padding: 18px 20px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }
  .card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .card__name {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .card__summary {
    font-size: 14px;
    line-height: 1.5;
    color: var(--text);
    margin: 0;
    flex: 1;
  }
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }
</style>
