---
import ProjectPreview from "@/components/ProjectPreview.astro";
import StatusBadge from "@/components/StatusBadge.astro";
import TagChip from "@/components/TagChip.astro";

export interface Props {
  name: string;
  status: "released" | "in-progress" | "idea";
  summary: string;
  tags: string[];
  previewKind: "phone-pc" | "browser" | "terminal" | "code" | "shortcut";
  screenshot?: string;
  slug: string;
  tone?: "sage" | "sand" | "lavender";
  headingLevel?: 2 | 3;
}
const { name, status, summary, tags, previewKind, screenshot, slug, tone, headingLevel = 3 } = Astro.props;
---
<a class="card" href={`/projects/${slug}`}>
  <div class="card__preview">
    <ProjectPreview previewKind={previewKind} screenshot={screenshot} alt={`Preview of ${name}`} tone={tone} />
  </div>
  <div class="card__body">
    <div class="card__header">
      {headingLevel === 2 ? <h2 class="card__name">{name}<span class="dot" aria-hidden="true">.</span></h2> : <h3 class="card__name">{name}<span class="dot" aria-hidden="true">.</span></h3>}
      <StatusBadge status={status} />
    </div>
    <p class="card__summary">{summary}</p>
    <div class="card__tags">{tags.map((tag) => <TagChip label={tag} />)}</div>
  </div>
</a>

<style>
  .card { display: flex; min-width: 0; height: 100%; flex-direction: column; overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius-card); color: inherit; background: var(--surface); text-decoration: none; transition: var(--motion); }
  .card:hover { border-color: var(--primary); color: inherit; box-shadow: var(--shadow-card); transform: translateY(-2px); }
  .card__preview { width: 100%; aspect-ratio: 16 / 9; flex: 0 0 auto; overflow: hidden; }
  .card__preview :global(.preview) { height: 100%; border: 0; border-radius: 0; }
  .card__body { display: flex; flex: 1; flex-direction: column; gap: 9px; padding: 16px 18px 18px; }
  .card__header { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .card__name { min-width: 0; color: var(--ink); font-size: 19px; line-height: 1.25; letter-spacing: -0.02em; overflow-wrap: anywhere; }
  .card__summary { flex: 1; color: var(--text); font-size: 14px; line-height: 1.5; }
  .card__tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 3px; }
  @media (max-width: 380px) { .card__body { padding: 14px; } .card__name { font-size: 17px; } }
</style>
