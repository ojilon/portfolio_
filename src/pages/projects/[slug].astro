---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectPreview from "@/components/ProjectPreview.astro";
import TagChip from "@/components/TagChip.astro";
import Gallery from "@/components/Gallery.astro";
import { projects } from "@/data/projects";
import { site } from "@/data/site";
import { formatDate } from "@/utils/date";
import { fitDescription } from "@/utils/seo";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
interface Props { project: (typeof projects)[number]; }
const { project } = Astro.props;
const statusLabel = project.status === "in-progress" ? "IN PROGRESS" : project.status.toUpperCase();
const title = `${project.name} | Ojilong Yusuf`;
const desc = fitDescription(`${project.name} — ${project.summary} Explore the project details, release links and source code by Ojilong Yusuf, a software builder in Uganda.`);
const siteUrl = process.env.SITE_URL ?? "https://example.com";
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: project.name,
  description: project.summary,
  author: { "@type": "Person", name: site.name },
  codeRepository: project.repoUrl,
  url: new URL(`/projects/${project.slug}/`, siteUrl).toString(),
});
const galleryItems = project.gallery?.map((src, index) => ({
  src,
  alt: `${project.name} — view ${index + 1}`,
  caption: ["Overview", "Workflow", "Detail view"][index] ?? `View ${index + 1}`,
})) ?? [];
const projectLinks = [
  { label: "Release page", url: project.releaseUrl },
  { label: "Documentation", url: project.docsUrl },
  { label: "Source code", url: project.repoUrl },
];
---
<BaseLayout title={title} description={desc} pathname={Astro.url.pathname} ogImage={project.screenshot ?? "/og-default.png"} jsonLd={jsonLd}>
  <section class="project-detail section">
    <div class="container">
      <div class="detail__top">
        <div class="detail__text">
          <p class="detail__eyebrow eyebrow"><span class="accent-dot" aria-hidden="true"></span>PROJECT DETAIL · {statusLabel}</p>
          <h1 class="detail__title">{project.name}<span class="dot" aria-hidden="true">.</span></h1>
          <p class="detail__desc">{project.summary}</p>
          <div class="detail__tags">{project.tags.map((tag) => <TagChip label={tag} />)}</div>
          <div class="detail__actions">
            <a href="#project-links" class="btn btn--fill">Explore release links <span aria-hidden="true">↓</span></a>
            <a href="/projects" class="btn btn--outline">Back to projects <span aria-hidden="true">↗</span></a>
          </div>
          <p class="detail__updated updated"><span class="accent-dot" aria-hidden="true"></span>Updated on {formatDate(project.updated)}</p>
        </div>
        <div class="detail__preview">
          <ProjectPreview previewKind={project.previewKind} tone={project.tone} screenshot={project.screenshot} alt={`Preview of ${project.name}`} width={800} height={450} loading="eager" />
        </div>
      </div>
      <hr class="section-line" />
      <section class="detail-look" id="look">
        <p class="look__eyebrow eyebrow"><span class="accent-dot" aria-hidden="true"></span>A CLOSER LOOK</p>
        <h2 class="look__title">Screens &amp; details.</h2>
        <Gallery items={galleryItems} />
      </section>
      <hr class="section-line" />
      <section class="detail-reason">
        <div class="reason__inner">
          <div class="reason__text">
            <p class="reason__eyebrow eyebrow"><span class="accent-dot" aria-hidden="true"></span>THE REASON BEHIND IT</p>
            <h2 class="reason__title"><span>{project.reasonTitle[0]}</span><span>{project.reasonTitle[1]}</span></h2>
            {project.reasonBody.map((paragraph) => <p class="reason__para">{paragraph}</p>)}
          </div>
          <div class="reason__links" id="project-links">
            <div class="links-card">
              <p class="links-card__title">Project links</p>
              {projectLinks.map((link) => (
                <div class="links-card__row">
                  <span class="links-card__label">{link.label}</span>
                  {link.url ? <a href={link.url} class="links-card__open" target="_blank" rel="noreferrer">Open <span aria-hidden="true">↗</span></a> : <span class="links-card__empty">add URL</span>}
                </div>
              ))}
              <p class="links-card__note">Links and screenshots are placeholders for this concept screen.</p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .project-detail { padding-top: 48px; padding-bottom: 80px; }
  .detail__top { display: grid; grid-template-columns: 0.92fr 1.08fr; gap: 48px; align-items: center; }
  .detail__eyebrow { margin-bottom: 12px; }
  .detail__title { margin-bottom: 14px; font-size: clamp(42px, 5.2vw, 72px); line-height: 1; letter-spacing: -0.04em; overflow-wrap: anywhere; }
  .detail__desc { max-width: 500px; margin-bottom: 16px; font-size: var(--text-lg); }
  .detail__tags, .detail__actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .detail__tags { margin-bottom: 20px; }
  .detail__actions { gap: 10px; margin-bottom: 16px; }
  .detail__updated { color: var(--text); }
  .detail__preview { width: 100%; aspect-ratio: 16 / 9; }
  .detail__preview :global(.preview) { height: 100%; border-radius: var(--radius-panel); }
  .project-detail .section-line { margin: 52px 0; }
  .look__eyebrow { margin-bottom: 10px; }
  .look__title { margin-bottom: 20px; font-size: var(--h2-desktop); }
  .reason__inner { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 48px; align-items: start; }
  .reason__eyebrow { margin-bottom: 12px; }
  .reason__title { margin-bottom: 16px; color: var(--ink); font-size: 32px; line-height: 1.12; }
  .reason__title span { display: block; }
  .reason__title span + span { color: var(--primary); }
  .reason__para { max-width: 700px; margin-top: 12px; font-size: 16px; }
  .links-card { padding: 18px 20px; border: 1px solid var(--border); border-radius: var(--radius-card); background: var(--surface); }
  .links-card__title { margin-bottom: 8px; color: var(--ink); font-size: 15px; font-weight: 700; }
  .links-card__row { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-top: 1px solid var(--border); font-size: 13px; }
  .links-card__label { color: var(--text); }
  .links-card__open, .links-card__empty { font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }
  .links-card__open { color: var(--primary); }
  .links-card__empty { color: var(--muted); }
  .links-card__note { margin-top: 12px; color: var(--muted); font-size: 11px; }
  @media (max-width: 800px) {
    .detail__top { grid-template-columns: 1fr; gap: 28px; }
    .detail__preview { max-height: 360px; }
    .reason__inner { grid-template-columns: 1fr; gap: 28px; }
  }
  @media (max-width: 640px) {
    .project-detail { padding-top: 36px; }
    .project-detail .section-line { margin: 40px 0; }
    .detail__actions .btn { font-size: 13px; }
    .look__title { font-size: var(--h2-mobile); }
    .reason__title { font-size: 27px; }
  }
</style>
