---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/data/projects";
import { formatDate } from "@/utils/date";

const desc = "Software with a practical purpose: small tools built around the parts of work and learning that could be simpler, by Ojilong Yusuf in Uganda.";
const updated = projects.reduce((latest, project) => project.updated > latest ? project.updated : latest, "");
---
<BaseLayout title="Projects | Ojilong Yusuf" description={desc} pathname={Astro.url.pathname} ogImage="/og-default.png">
  <section class="projects-page section">
    <div class="container">
      <div class="projects__header">
        <div>
          <p class="projects__eyebrow eyebrow"><span class="accent-dot" aria-hidden="true"></span>A GROWING TOOLKIT</p>
          <h1 class="projects__title">Software with a practical purpose.</h1>
          <p class="projects__sub">Small tools, experiments and ideas—built around the parts of work and learning that could be simpler.</p>
        </div>
        <p class="projects__updated updated"><span class="accent-dot" aria-hidden="true"></span>Updated on {formatDate(updated)}</p>
      </div>
      <div class="projects__grid">
        {projects.map((project) => (
          <ProjectCard
            name={project.name}
            status={project.status}
            summary={project.summary}
            tags={project.tags}
            previewKind={project.previewKind}
            tone={project.tone}
            headingLevel={2}
            screenshot={project.screenshot}
            slug={project.slug}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .projects__header { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; }
  .projects__eyebrow { margin-bottom: 10px; }
  .projects__title { max-width: 820px; margin-bottom: 10px; font-size: var(--page-title); letter-spacing: -0.035em; }
  .projects__sub { max-width: 720px; font-size: var(--text-lg); }
  .projects__updated { flex: 0 0 auto; margin-bottom: 4px; }
  .projects__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 32px; }
  @media (max-width: 960px) { .projects__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .projects__header { flex-direction: column; align-items: flex-start; gap: 14px; }
    .projects__title { font-size: var(--page-title-mobile); }
    .projects__sub { font-size: 16px; }
    .projects__grid { grid-template-columns: 1fr; gap: 14px; margin-top: 24px; }
  }
</style>
