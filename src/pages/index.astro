---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/Hero.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { featuredProjects } from "@/data/projects";
import { site } from "@/data/site";

const desc =
  "Ojilong Yusuf — biology and chemistry teacher trainee at Kyambogo University, Uganda, and builder of practical software tools for education.";
---
<BaseLayout
  title="Ojilong Yusuf | Biology & Chemistry Teacher Trainee and Software Builder, Uganda"
  description={desc}
  pathname={Astro.url.pathname}
  ogImage="/og-default.png"
>
  <Hero />
  <hr class="section-line" />
  <section class="home-featured section">
    <div class="container">
      <div class="home-featured__head">
        <div>
          <p class="home-featured__eyebrow eyebrow">
            <span class="accent-dot" aria-hidden="true"></span>
            A FEW THINGS TAKING SHAPE
          </p>
          <h2 class="home-featured__title">Built to be useful.</h2>
          <p class="home-featured__sub">
            Practical tools, shaped by the small frictions people meet every day.
          </p>
        </div>
        <a href="/projects" class="home-featured__all">All projects<span class="link-arrow">→</span></a>
      </div>
      <div class="home-featured__grid">
        {featuredProjects.map((p) => (
          <ProjectCard
            name={p.name}
            status={p.status}
            summary={p.summary}
            tags={p.tags}
            previewKind={p.previewKind}
            screenshot={p.screenshot}
            slug={p.slug}
          />
        ))}
      </div>
    </div>
  </section>
  <hr class="section-line" />
  <section class="home-notes section">
    <div class="container home-notes__inner">
      <div class="home-notes__text">
        <p class="home-notes__eyebrow eyebrow">
          <span class="accent-dot" aria-hidden="true"></span>
          MADE FOR LEARNING
        </p>
        <h2 class="home-notes__title">Notes to make a concept click.</h2>
        <p class="home-notes__desc">
          Short biology and chemistry explainers, one idea at a time.
        </p>
        <a href="/teaching#notes" class="btn btn--outline">Browse revision notes<span class="link-arrow">→</span></a>
      </div>
      <div class="home-notes__grid" id="notes-grid">
        <div class="home-notes__empty">
          <p>Explore the full set of revision notes on the Teaching page.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-featured__head { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  @media (min-width: 769px) { .home-featured__head { flex-direction: row; justify-content: space-between; align-items: flex-end; width: 100%; } }
  .home-featured__title { font-size: var(--h2-desktop); line-height: 1.05; margin: 4px 0 8px 0; }
  @media (max-width: 768px) { .home-featured__title { font-size: var(--h2-mobile); } }
  .home-featured__sub { color: var(--text); font-size: var(--text-lg); line-height: var(--leading-body); margin: 0; max-width: 460px; }
  .home-featured__all { font-weight: 700; color: var(--primary); font-size: 15px; }
  .home-featured__all:hover { text-decoration: underline; }
  .home-featured__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 30px; }
  @media (max-width: 900px) { .home-featured__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .home-featured__grid { grid-template-columns: 1fr; } }
  .home-notes__inner { border-radius: var(--radius-panel); border: 1px solid var(--border); background: var(--sage); padding: 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start; }
  @media (max-width: 768px) { .home-notes__inner { grid-template-columns: 1fr; gap: 24px; padding: 28px 20px; } }
  .home-notes__desc { color: var(--text); font-size: var(--text-lg); line-height: var(--leading-body); margin: 0 0 18px 0; }
  .home-notes__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 768px) { .home-notes__grid { gap: 12px; } }
  .home-notes__empty { grid-column: 1 / -1; color: var(--muted); font-size: 14px; text-align: center; padding: 20px; }
</style>
