---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";

const desc = "Contact Ojilong Yusuf, a biology and chemistry teacher trainee and software builder in Uganda, about education technology, teaching resources or software projects.";
const title = "Contact | Ojilong Yusuf";
const hasEmail = !site.email.startsWith("TODO:");
---
<BaseLayout title={title} description={desc} pathname={Astro.url.pathname} ogImage="/og-default.png">
  <section class="contact section">
    <div class="container">
      <div class="contact__head">
        <p class="contact__eyebrow eyebrow"><span class="accent-dot" aria-hidden="true"></span>CONTACT</p>
        <h1 class="contact__title">Let’s talk.</h1>
        <p class="contact__desc">I’m open to collaboration on education technology, teaching resources and software projects. Reach me by email, GitHub or X.</p>
      </div>
      <div class="contact__links">
        {hasEmail ? (
          <a href={`mailto:${site.email}`} class="contact__row">
            <span class="contact__row-label">Email</span><span class="contact__row-value">{site.email}</span><span class="contact__row-arrow" aria-hidden="true">↗</span>
          </a>
        ) : (
          <div class="contact__row contact__row--placeholder">
            <span class="contact__row-label">Email</span><span class="contact__row-value">TODO: replace with an email address</span><span class="contact__row-arrow" aria-hidden="true">↗</span>
          </div>
        )}
        <a href={site.social.github} class="contact__row" target="_blank" rel="noreferrer">
          <span class="contact__row-label">GitHub</span><span class="contact__row-value">github.com/ojilon</span><span class="contact__row-arrow" aria-hidden="true">↗</span>
        </a>
        <a href={site.social.x} class="contact__row" target="_blank" rel="noreferrer">
          <span class="contact__row-label">X</span><span class="contact__row-value">@OJI_OJI_00</span><span class="contact__row-arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact__head { margin-bottom: 34px; }
  .contact__eyebrow { margin-bottom: 12px; }
  .contact__title { margin-bottom: 14px; font-size: var(--page-title); letter-spacing: -0.035em; }
  .contact__desc { max-width: 640px; font-size: var(--text-lg); }
  .contact__links { display: grid; max-width: 850px; gap: 12px; }
  .contact__row { display: grid; grid-template-columns: 120px minmax(0, 1fr) 20px; align-items: center; gap: 16px; padding: 18px 22px; border: 1px solid var(--border); border-radius: var(--radius-card); color: inherit; background: var(--surface); }
  a.contact__row:hover { border-color: var(--primary); color: inherit; box-shadow: var(--shadow-card); }
  .contact__row-label { color: var(--muted); font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .contact__row-value { min-width: 0; overflow-wrap: anywhere; color: var(--text); font-size: 15px; }
  .contact__row--placeholder .contact__row-value { color: var(--accent-text); font-family: var(--font-mono); font-size: 12px; }
  .contact__row-arrow { color: var(--accent); font-size: 17px; text-align: right; }
  @media (max-width: 760px) {
    .contact__title { font-size: var(--page-title-mobile); }
    .contact__desc { font-size: 16px; }
    .contact__row { grid-template-columns: 1fr auto; gap: 8px; padding: 16px; }
    .contact__row-value { grid-column: 1; }
    .contact__row-arrow { grid-column: 2; grid-row: 1 / span 2; }
  }
</style>
