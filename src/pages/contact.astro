---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/data/site";

const desc =
  "Get in touch with Ojilong Yusuf — biology and chemistry teacher trainee and software builder in Uganda — about education technology, teaching resources or software projects.";
const title = "Contact | Ojilong Yusuf";
---
<BaseLayout title={title} description={desc} pathname={Astro.url.pathname} ogImage="/og-default.png">
  <section class="contact section">
    <div class="container">
      <div class="contact__head">
        <p class="contact__eyebrow eyebrow">
          <span class="accent-dot" aria-hidden="true"></span>
          CONTACT
        </p>
        <h1 class="contact__title">Let’s talk.</h1>
        <p class="contact__desc">
          I’m open to collaboration on education technology, teaching resources, and software projects. Reach me by email,
          GitHub, or X. No form — just a real inbox.
        </p>
      </div>
      <div class="contact__links">
        <a href={site.links.find((l) => l.label === "Email")?.url ?? site.email} class="contact__row">
          <span class="contact__row-label">Email</span>
          <span class="contact__row-value">{site.links.find((l) => l.label === "Email")?.url ?? site.email}</span>
          <span class="contact__row-arrow">↗</span>
        </a>
        <a href={site.links.find((l) => l.label === "GitHub")?.url} class="contact__row">
          <span class="contact__row-label">GitHub</span>
          <span class="contact__row-value">{site.links.find((l) => l.label === "GitHub")?.url}</span>
          <span class="contact__row-arrow">↗</span>
        </a>
        <a href={site.links.find((l) => l.label === "X · @OJI_OJI_00")?.url} class="contact__row">
          <span class="contact__row-label">X</span>
          <span class="contact__row-value">@OJI_OJI_00</span>
          <span class="contact__row-arrow">↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact__head { margin-bottom: 34px; }
  .contact__eyebrow { margin: 0 0 12px 0; }
  .contact__title {
    font-size: 40px;
    line-height: 1.05;
    margin: 0 0 14px 0;
  }
  @media (max-width: 768px) { .contact__title { font-size: 30px; } }
  .contact__desc {
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--text);
    margin: 0;
    max-width: 560px;
  }
  .contact__links {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .contact__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-radius: var(--radius-card);
    border: 1px solid var(--border);
    background: var(--surface);
    padding: 18px 22px;
    text-decoration: none;
    color: inherit;
  }
  .contact__row:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-card);
  }
  .contact__row-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    flex-shrink: 0;
  }
  .contact__row-value {
    font-size: 15px;
    color: var(--text);
    flex: 1;
    min-width: 0;
  }
  .contact__row-value {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .contact__row-arrow {
    color: var(--accent);
    font-size: 16px;
    flex-shrink: 0;
  }
  @media (max-width: 640px) {
    .contact__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 16px 20px;
    }
    .contact__row-value {
      white-space: normal;
      order: 2;
      width: 100%;
    }
    .contact__row-arrow {
      order: 1;
      align-self: flex-start;
    }
  }
</style>
