---
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Not found | Ojilong Yusuf";
const desc = "This page doesn’t exist. Head back to the home or projects page.";
---
<BaseLayout title={title} description={desc} pathname={Astro.url.pathname} noindex ogImage="/og-default.png">
  <section class="not-found section">
    <div class="container">
      <p class="not-found__eyebrow eyebrow">
        <span class="accent-dot" aria-hidden="true"></span>
        NOT FOUND
      </p>
      <h1 class="not-found__title">This page isn’t here.</h1>
      <p class="not-found__desc">
        It may have moved or never existed. Pick a place to go from here.
      </p>
      <div class="not-found__actions">
        <a href="/" class="btn btn--fill">Go home<span class="link-arrow">↗</span></a>
        <a href="/projects" class="btn btn--outline">See projects<span class="link-arrow">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { text-align: center; }
  .not-found__eyebrow { margin: 0 0 12px 0; }
  .not-found__title {
    font-size: 56px;
    line-height: 1.05;
    margin: 0 0 14px 0;
    letter-spacing: -0.02em;
  }
  @media (max-width: 768px) { .not-found__title { font-size: 40px; } }
  .not-found__desc {
    font-size: var(--text-lg);
    color: var(--text);
    margin: 0 0 26px 0;
    max-width: 460px;
    margin-left: auto;
    margin-right: auto;
  }
  .not-found__actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
